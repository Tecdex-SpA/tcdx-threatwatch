# Variables de entorno de vulnera.tecdex.net (misión doc 47, P0-2).
# Copiar a .env.local para desarrollo. En producción se cargan en Vercel
# (Project Settings → Environment Variables) y requieren un nuevo deploy.

# Origen canónico del sitio (sin barra final).
SITE_URL=https://vulnera.tecdex.net

# GA4 propio de VULNERA (formato G-XXXXXXXXXX). Vacío = no se carga analítica.
# ACCIÓN_MARIO: crear la propiedad GA4 y pegar aquí / en Vercel el ID de medición.
ANALYTICS_GA4_ID=

# Contenido del meta-tag google-site-verification (solo el valor de content).
# ACCIÓN_MARIO: Search Console, propiedad de prefijo https://vulnera.tecdex.net/
GSC_VERIFICATION=

# Contenido del meta-tag msvalidate.01 (solo el valor de content).
# ACCIÓN_MARIO: Bing Webmaster Tools.
BING_VERIFICATION=

# Modo preparación: la venta al público no está liberada.
FEATURE_SALES_PUBLIC=false
